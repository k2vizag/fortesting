{"total": 48.4, "lines": [
 {"start": 0.00, "end": 2.76, "scene": 0, "text": "ఎండలను దండిస్తామా"},
 {"start": 2.76, "end": 4.42, "scene": 1, "text": "వానలను నిందిస్తామా"},
 {"start": 4.42, "end": 8.48, "scene": 2, "text": "చలినెటో తరిమేస్తామా|చీ పొమ్మనీ"},
 {"start": 8.48, "end": 10.88, "scene": 3, "text": "కస్సుమని కలహిస్తామా"},
 {"start": 10.88, "end": 12.98, "scene": 4, "text": "ఉస్సురని విలపిస్తామా"},
 {"start": 12.98, "end": 17.20, "scene": 5, "text": "రోజులతో రాజీ పడమా|సర్లెమ్మనీ"},
 {"start": 17.20, "end": 21.40, "scene": 6, "text": "సాటి మనుషులతో మాత్రం"},
 {"start": 21.40, "end": 25.40, "scene": 7, "text": "సాగనని ఎందుకు పంతం"},
 {"start": 25.40, "end": 29.10, "scene": 8, "text": "పూటకొక పేచీ పడుతూ"},
 {"start": 29.10, "end": 33.90, "scene": 9, "text": "ఏం సాధిస్తామంటే|ఏం చెబుతాం"},
 {"start": 33.90, "end": 38.00, "scene": 10, "text": "ఎక్కిళ్ళే పెట్టి ఏడుస్తుంటే|కష్టం పోతుందా"},
 {"start": 38.00, "end": 42.10, "scene": 11, "text": "కదా మరెందుకు గోల"},
 {"start": 42.10, "end": 44.00, "scene": 12, "text": "అయ్యయ్యో పాపం అంటే"},
 {"start": 44.00, "end": 46.20, "scene": 13, "text": "ఏదో లాభం వస్తుందా"},
 {"start": 46.20, "end": 48.40, "scene": 14, "text": "వృధా ప్రయాస పడాలా"}
]}
