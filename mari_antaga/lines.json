{
 "total": 48.4,
 "lines": [
  {
   "start": 0.0,
   "end": 2.76,
   "scene": 0,
   "text": "ఎండలను దండిస్తామా",
   "en": "Do we punish the scorching sun?"
  },
  {
   "start": 2.76,
   "end": 4.42,
   "scene": 1,
   "text": "వానలను నిందిస్తామా",
   "en": "Do we blame the rain?"
  },
  {
   "start": 4.42,
   "end": 8.48,
   "scene": 2,
   "text": "చలినెటో తరిమేస్తామా|చీ పొమ్మనీ",
   "en": "Do we chase the cold away,|saying “go away”?"
  },
  {
   "start": 8.48,
   "end": 10.88,
   "scene": 3,
   "text": "కస్సుమని కలహిస్తామా",
   "en": "Do we fight the seasons in anger?"
  },
  {
   "start": 10.88,
   "end": 12.98,
   "scene": 4,
   "text": "ఉస్సురని విలపిస్తామా",
   "en": "Do we sit and sigh in sorrow?"
  },
  {
   "start": 12.98,
   "end": 17.2,
   "scene": 5,
   "text": "రోజులతో రాజీ పడమా|సర్లెమ్మనీ",
   "en": "We make peace with the days,|saying “okay”"
  },
  {
   "start": 17.2,
   "end": 21.4,
   "scene": 6,
   "text": "సాటి మనుషులతో మాత్రం",
   "en": "But with our fellow human beings…"
  },
  {
   "start": 21.4,
   "end": 25.4,
   "scene": 7,
   "text": "సాగనని ఎందుకు పంతం",
   "en": "…why this stubbornness|not to get along?"
  },
  {
   "start": 25.4,
   "end": 29.1,
   "scene": 8,
   "text": "పూటకొక పేచీ పడుతూ",
   "en": "Quarrelling every few hours —"
  },
  {
   "start": 29.1,
   "end": 33.9,
   "scene": 9,
   "text": "ఏం సాధిస్తామంటే|ఏం చెబుతాం",
   "en": "If asked what we gain,|what answer do we have?"
  },
  {
   "start": 33.9,
   "end": 38.0,
   "scene": 10,
   "text": "ఎక్కిళ్ళే పెట్టి ఏడుస్తుంటే|కష్టం పోతుందా",
   "en": "Will sobbing and crying|make troubles go away?"
  },
  {
   "start": 38.0,
   "end": 42.1,
   "scene": 11,
   "text": "కదా మరెందుకు గోల",
   "en": "It won’t — so why all this fuss?"
  },
  {
   "start": 42.1,
   "end": 44.0,
   "scene": 12,
   "text": "అయ్యయ్యో పాపం అంటే",
   "en": "If people say “oh, poor thing”,"
  },
  {
   "start": 44.0,
   "end": 46.2,
   "scene": 13,
   "text": "ఏదో లాభం వస్తుందా",
   "en": "will we gain anything from it?"
  },
  {
   "start": 46.2,
   "end": 48.4,
   "scene": 14,
   "text": "వృధా ప్రయాస పడాలా",
   "en": "Should we struggle for nothing?"
  }
 ]
}